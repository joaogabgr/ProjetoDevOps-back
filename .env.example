# Aplicação
NODE_ENV=development
PORT=3000

# Sessão (RF9): segredo do token, com 32 caracteres ou mais, e validade em horas
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
SESSION_HOURS=8

# Primeiro administrador, usado só por `npm run seed:admin`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@vigia.org
ADMIN_PASSWORD=troque-esta-senha
ADMIN_CPF=52998224725

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=tecsus
DB_PASSWORD=tecsus
DB_NAME=tecsus

# Mostra no console o SQL gerado pelo TypeORM
DB_LOGGING=false
